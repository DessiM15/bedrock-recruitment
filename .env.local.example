# Web3Forms access key for the contact form (delivers to the email the key was
# created with). Must be NEXT_PUBLIC_ — the form submits from the browser
# because Web3Forms rejects server-side calls on the free plan.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Resend API Key for form submissions
RESEND_API_KEY=re_your_api_key_here

# Email address to receive form notifications
NOTIFICATION_EMAIL=team@bedrockfinancialplanning.com

# Hero video URL (upload to Vercel Blob Storage, then paste URL here)
NEXT_PUBLIC_HERO_VIDEO_URL=
